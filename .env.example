NODE_ENV=development
PORT=4000
# Browser origins allowed to call the API (storefront, admin app)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dia
DB_PASSWORD=dia
DB_NAME=dia
DB_SSL=false
# true = create/alter tables from entities automatically. Never in production: use migrations.
DB_SYNCHRONIZE=false
# Apply pending migrations at startup (or run `npm run migration:run` yourself).
DB_MIGRATIONS_RUN=true

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_MS=60000

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=dia


# Payment providers (enabled when keys are set)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
COD_ENABLED=false
ORDER_PAYMENT_TTL_MINUTES=30

# Auth
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
JWT_ISSUER=dia-server
JWT_AUDIENCE=dia-storefront
ACCESS_TOKEN_TTL=15m
APP_URL=http://localhost:3000
# First admin, created on boot when no admin exists
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# Social login (comma separated client ids)
# GOOGLE_CLIENT_IDS=

# Email (Resend) and SMS (OTPFlow). Without them, messages are logged (dev only).
# MAIL_FROM=Dia <orders@yourdomain.com>
# MAIL_FROM_ACCOUNT=Dia <no-reply@yourdomain.com>   # verification + password emails; defaults to MAIL_FROM
# RESEND_API_KEY=
# RESEND_VERIFY_TEMPLATE_ID=   # published Resend template for the verify email (variables: first_name, company_name, company_address, magic_link_url)
# COMPANY_NAME=Dia Diamonds
# COMPANY_ADDRESS=
# OTPFLOW_API_KEY=            # otpf_… ; we make the code, OTPFlow delivers it (Indian mobiles)

# Image uploads: Cloudflare R2 bucket (create an API token with Object Read & Write on the bucket)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Where the admin app is served (password links for the team open here)
ADMIN_URL=http://localhost:5173
